From 576fd26efa67a30b67ec362a2cf4c4359c9c30cd Mon Sep 17 00:00:00 2001
From: Alastair Swan <alastair.swan@bommanager.org>
Date: Mon, 26 Oct 2026 23:15:58 -0700
Subject: [PATCH] [Decode] Fix use-after-free when DestroyContext races
 StatusCheck

StatusCheck could read surface->pDecCtx while another thread called
DestroyContext leading to a use-after-free race condition causing
a SEGFAULT in some players when switching tracks.
A guard is added inside DestroyContex and StatusCheck to ensure
that decCtx is not freed while being checked inside StatusCheck

Signed-off-by: Alastair Swan <alastair.swan@bommanager.org>
---
 .../linux/common/codec/ddi/dec/ddi_decode_functions.cpp    | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/media_softlet/linux/common/codec/ddi/dec/ddi_decode_functions.cpp b/media_softlet/linux/common/codec/ddi/dec/ddi_decode_functions.cpp
index f185a0e0da..3c2fe74296 100644
--- a/media_softlet/linux/common/codec/ddi/dec/ddi_decode_functions.cpp
+++ b/media_softlet/linux/common/codec/ddi/dec/ddi_decode_functions.cpp
@@ -414,6 +414,8 @@ VAStatus DdiDecodeFunctions::DestroyContext(
 
     if (decCtx->m_ddiDecodeNext)
     {
+        // guard against decCtx use-after-free in StatusCheck
+        MediaLibvaUtilNext_LockGuard guard(&mediaCtx->SurfaceMutex);
         CleanUp(ctx, decCtx);
         return VA_STATUS_SUCCESS;
     }
@@ -1017,8 +1019,11 @@ VAStatus DdiDecodeFunctions::StatusCheck(
     DDI_CODEC_CHK_NULL(surface,  "nullptr surface in Decode StatusCheck", VA_STATUS_ERROR_INVALID_CONTEXT);
 
     uint32_t i = 0;
-    PDDI_DECODE_CONTEXT decCtx = (decltype(decCtx))surface->pDecCtx;
+
+    // guard against pDecCtx has been freed by DestroyContext
     MediaLibvaUtilNext_LockGuard guard(&mediaCtx->SurfaceMutex);
+    PDDI_DECODE_CONTEXT decCtx = (decltype(decCtx))surface->pDecCtx;
+    DDI_CODEC_CHK_NULL(decCtx, "nullptr surface->pDecCtx", VA_STATUS_SUCCESS);
 
     Codechal *codecHal = decCtx->pCodecHal;
     // return success just avoid vaDestroyContext is ahead of vaSyncSurface
